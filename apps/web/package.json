{
  "name": "@builder/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @builder/mcp build && node scripts/copy-scalar.ts && next dev",
    "build": "pnpm --filter @builder/mcp build && node scripts/copy-scalar.ts && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:only": "playwright test"
  },
  "dependencies": {
    "@builder/core": "workspace:*",
    "@builder/db": "workspace:*",
    "@builder/format": "workspace:*",
    "@builder/mcp": "workspace:*",
    "@builder/print": "workspace:*",
    "@builder/sheet": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@scalar/nextjs-api-reference": "0.12.8",
    "fflate": "^0.8.3",
    "next": "^16.3.8",
    "nodemailer": "10.0.13",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@builder/demo-package": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.63.0",
    "@scalar/api-reference": "1.73.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
