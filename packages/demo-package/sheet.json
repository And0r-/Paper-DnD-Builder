{
  "sections": [
    {
      "id": "header",
      "kind": "header",
      "span": 12,
      "fields": [
        {
          "choice": "folk"
        },
        {
          "choice": "upbringing"
        }
      ]
    },
    {
      "id": "primary",
      "kind": "statBoxes",
      "span": 12,
      "boxes": [
        {
          "value": "stamina",
          "style": "pencil"
        },
        {
          "value": "guard",
          "style": "number"
        },
        {
          "value": "pace",
          "style": "number"
        },
        {
          "value": "luck",
          "style": "circles"
        },
        {
          "value": "nerve",
          "style": "number",
          "label": "sheet.primary.nerve"
        },
        {
          "value": "practice",
          "style": "number"
        }
      ]
    },
    {
      "id": "recovery",
      "kind": "statBoxes",
      "span": 12,
      "boxes": [
        {
          "value": "restDice",
          "style": "boxes",
          "text": {
            "text": "sheet.recovery.rest-dice",
            "vars": {
              "count": "restDice",
              "die": "restDie"
            }
          }
        },
        {
          "value": "closeCallsMade",
          "style": "boxes"
        },
        {
          "value": "closeCallsMissed",
          "style": "boxes"
        }
      ]
    },
    {
      "id": "scores",
      "kind": "scoreColumn",
      "span": 4,
      "scores": [
        {
          "value": "might",
          "derived": "mightBonus",
          "extra": "mightHold",
          "extraLabel": "sheet.scores.hold"
        },
        {
          "value": "grace",
          "derived": "graceBonus",
          "extra": "graceHold",
          "extraLabel": "sheet.scores.hold"
        },
        {
          "value": "wit",
          "derived": "witBonus",
          "extra": "witHold",
          "extraLabel": "sheet.scores.hold"
        },
        {
          "value": "heart",
          "derived": "heartBonus",
          "extra": "heartHold",
          "extraLabel": "sheet.scores.hold"
        }
      ]
    },
    {
      "id": "talents",
      "kind": "checkList",
      "span": 8,
      "things": {
        "kind": "talent"
      },
      "note": "score",
      "total": "roll",
      "strong": {
        "kind": "flair"
      }
    },
    {
      "id": "attacks",
      "kind": "statTable",
      "span": 8,
      "things": {
        "tags": ["armed"]
      },
      "columns": [
        {
          "stat": "hit",
          "signed": true
        },
        {
          "stat": "harm"
        },
        {
          "stat": "range"
        },
        {
          "stat": "traits",
          "wrap": true
        }
      ]
    },
    {
      "id": "rolls",
      "kind": "statBoxes",
      "span": 4,
      "boxes": [
        {
          "value": "sneakRoll",
          "style": "number",
          "label": "sheet.rolls.sneak"
        }
      ]
    },
    {
      "id": "traits",
      "kind": "featureTable",
      "span": 8,
      "things": {
        "kind": "trait"
      },
      "uses": "uses",
      "groupBy": "origin"
    },
    {
      "id": "knacks",
      "kind": "featureTable",
      "span": 8,
      "things": {
        "kind": "knack"
      },
      "uses": "uses",
      "byRank": true,
      "marks": [
        {
          "text": "sheet.knacks.mark.calling",
          "legend": "sheet.knacks.mark.calling.legend",
          "how": "picked",
          "from": {
            "kind": "calling"
          }
        },
        {
          "text": "sheet.knacks.mark.path",
          "legend": "sheet.knacks.mark.path.legend",
          "how": "granted"
        },
        {
          "text": "sheet.knacks.mark.steady",
          "legend": "sheet.knacks.mark.steady.legend",
          "tags": ["steady"]
        }
      ],
      "lead": {
        "things": {
          "kind": "calling"
        },
        "text": "knacks.change"
      },
      "note": "reach"
    },
    {
      "id": "lantern-slots",
      "kind": "statBoxes",
      "span": 12,
      "when": "has('calling.lantern-bearer')",
      "boxes": [
        {
          "value": "lanternSlots1",
          "style": "circles",
          "label": "sheet.lantern-slots.rank1",
          "when": "lanternSlots1 > 0"
        },
        {
          "value": "lanternSlots2",
          "style": "circles",
          "label": "sheet.lantern-slots.rank2",
          "when": "lanternSlots2 > 0"
        },
        {
          "value": "lanternSlots3",
          "style": "circles",
          "label": "sheet.lantern-slots.rank3",
          "when": "lanternSlots3 > 0"
        },
        {
          "value": "lanternSlots4",
          "style": "circles",
          "label": "sheet.lantern-slots.rank4",
          "when": "lanternSlots4 > 0"
        },
        {
          "value": "lanternSlots5",
          "style": "circles",
          "label": "sheet.lantern-slots.rank5",
          "when": "lanternSlots5 > 0"
        }
      ]
    },
    {
      "id": "lantern-slots-high",
      "kind": "statBoxes",
      "span": 12,
      "boxes": [
        {
          "value": "lanternSlots6",
          "style": "circles",
          "label": "sheet.lantern-slots.rank6",
          "when": "lanternSlots6 > 0"
        },
        {
          "value": "lanternSlots7",
          "style": "circles",
          "label": "sheet.lantern-slots.rank7",
          "when": "lanternSlots7 > 0"
        },
        {
          "value": "lanternSlots8",
          "style": "circles",
          "label": "sheet.lantern-slots.rank8",
          "when": "lanternSlots8 > 0"
        },
        {
          "value": "lanternSlots9",
          "style": "circles",
          "label": "sheet.lantern-slots.rank9",
          "when": "lanternSlots9 > 0"
        }
      ]
    },
    {
      "id": "path",
      "kind": "featureTable",
      "span": 4,
      "things": {
        "kind": "path"
      },
      "when": "level >= 3"
    },
    {
      "id": "mastery",
      "kind": "answers",
      "span": 4,
      "when": "has('calling.lantern-bearer') and level >= 18",
      "choices": ["lantern-mastery"]
    },
    {
      "id": "practice",
      "kind": "answers",
      "span": 4,
      "when": "has('boon.deep-practice')",
      "choices": ["deep-practice"]
    },
    {
      "id": "gear",
      "kind": "list",
      "span": 6,
      "things": {
        "kind": "item"
      },
      "blankLines": 4
    },
    {
      "id": "how-to-play",
      "kind": "helpBox",
      "span": 6
    },
    {
      "id": "about",
      "kind": "answers",
      "span": 6,
      "choices": ["concept", "age", "looks"]
    },
    {
      "id": "notes",
      "kind": "notes",
      "span": 6,
      "lines": 6
    }
  ],
  "cards": {
    "knack": {
      "fields": ["reach", "duration", "uses", "focus"],
      "uses": "uses"
    }
  }
}
