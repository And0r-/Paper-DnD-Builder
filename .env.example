# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---------------------------------------------
# Defaults to "builder" when empty.
POSTGRES_DB=
POSTGRES_USER=
# Required. Use URL-safe characters only (e.g. output of `openssl rand -hex 32`).
POSTGRES_PASSWORD=

# --- Database (local development outside compose) --------------------------
# Example shape: postgres://USER:PASSWORD@localhost:5432/DB
DATABASE_URL=

# --- Content packages ---------------------------------------------------------
# Directory the builder loads content packages from: a folder of packages
# or a single package. Compose mounts ./packages-mount here read-only and
# sets this to /packages. For local development: packages/demo-package
PACKAGES_DIR=

# --- Web --------------------------------------------------------------------
# Public base URL, used in links inside mails and for the same-origin check
# (e.g. https://builder.example). With https, session cookies are Secure.
BASE_URL=
# Host port compose publishes the web app on. Defaults to 3000.
WEB_PORT=

# --- Mail (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
# "true" for implicit TLS (usually port 465), "false" for STARTTLS (then
# required: the mail carries a password).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. "Character Builder <builder@example>".
MAIL_FROM=
